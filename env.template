# Copy this file to .env and fill in your values:
#   cp env.template .env
#
# Also copy example config files:
#   cp config/companies.example.json config/companies.json
#   cp resume/master_resume.example.txt resume/master_resume.txt

# --- Profile (job search preferences) ---
USER_NAME=
TARGET_ROLES=Energy Analyst,Graduate Energy Analyst,Energy Consultant,Graduate Energy Consultant,Sustainability Analyst,Renewable Energy Analyst,Technical Analyst,Graduate Analyst,Materials Scientist,Materials Engineer,Graduate Materials Scientist,Battery Scientist,Battery Engineer,Electrochemistry Scientist,Electrochemist,Research Scientist,R&D Scientist,Graduate Scientist,Research Engineer,Clean Energy,Energy Technology,Graduate Chemist,Graduate STEM,Environmental Consultant,Graduate Researcher
JOB_LOCATION=London, United Kingdom
FILTER_BY_LOCATION=true
FILTER_BY_ROLE=true
# Generic STEM titles with a full description must have relevant domain evidence.
FILTER_BY_DOMAIN=true
MIN_MATCH_SCORE=65
EMAIL_MIN_SCORE=70
# Only email 70+ jobs posted within this many calendar days (2 = today + two days).
EMAIL_MAX_POSTED_DAYS=2
# Attach tailored resume + cover letter PDFs to 70+ job alerts.
# Keep false on the first fetch so you do not generate files (and spend tokens)
# for every matching job. Each emailed job is marked sent and is not re-sent.
EMAIL_ATTACH_MATERIALS=false
JOB_LOOKBACK=r604800

# Path to your company shortlist (copy from config/companies.example.json)
COMPANIES_CONFIG_PATH=config/companies.json

# Path to your master resume (for optional AI scoring / resume tailoring)
RESUME_PATH=resume/master_resume.txt
# ATS targets are diagnostic only; missing skills are never added to the CV.
RESUME_MIN_ATS_SCORE=80
RESUME_TARGET_ATS_SCORE=90

# --- API keys ---
# Gemini (preferred). Get a key at https://aistudio.google.com/apikey
# A Gemini Pro *app* subscription is separate from API quota.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
AI_PROVIDER=auto
GEMINI_SCORE_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.6-flash
GEMINI_LOCATION=us-central1
SCORE_BATCH_SIZE=80

# OpenAI fallback if Gemini fails (or is not set). https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional last-resort fallback if Gemini and OpenAI are not set
CLAUDE_API_KEY=

# --- Fetch settings ---
CHECK_INTERVAL_MINUTES=15
# Parallel threads for career-site fetches only. LinkedIn is always sequential.
FETCH_CONCURRENCY=8
# One term per Workday board per cycle, rotating through this list. Existing
# 20-result pages / 400-result maximum are unchanged. Empty means all roles.
WORKDAY_SEARCH_TERMS=graduate,energy,sustainability,materials,scientist,analyst,engineer
# Add company-independent London searches alongside the company shortlist.
# Four broad queries rotate per cycle, within LINKEDIN_MAX_SEARCHES_PER_CYCLE.
# Energy/materials searches for 2027 are prioritised in the first two groups.
ENABLE_BROAD_LINKEDIN_SEARCH=true
BROAD_SEARCH_QUERIES=graduate energy,2027 graduate energy,energy graduate scheme 2027,energy analyst,materials graduate,materials graduate 2027,graduate materials scientist 2027,electrochemistry,renewable energy graduate,sustainability graduate,materials scientist,battery scientist,graduate scientist,research scientist,clean energy graduate,net zero graduate,graduate engineer,technical analyst,2027 sustainability graduate,energy transition graduate 2027,graduate consultant energy 2027
BROAD_SEARCH_QUERIES_PER_CYCLE=4
# Official SmartRecruiters/Workday JSON details only; cached descriptions are
# reused, and pending detail attempts rotate. Zero disables detail requests.
ATS_DETAIL_REQUESTS_PER_BOARD=10
# LinkedIn guest search rate limits (keep conservative to avoid HTTP 429).
LINKEDIN_MIN_DELAY_SECONDS=6
LINKEDIN_MAX_REQUESTS_PER_MINUTE=10
LINKEDIN_MAX_REQUESTS_PER_HOUR=80
LINKEDIN_MAX_SEARCHES_PER_CYCLE=20

# --- Experience filter ---
# Full-time professional experience. Academic projects/internships are not employment.
# Preferences, 0-1 year ranges and academic alternatives are retained for scoring.
EXPERIENCE_YEARS=0
EXPERIENCE_MIN=0
EXPERIENCE_MAX=0
FILTER_BY_EXPERIENCE=true
# Completed qualifications and current study are deliberately separate.
HIGHEST_COMPLETED_EDUCATION=bachelors
CURRENT_EDUCATION=masters
CURRENT_EDUCATION_STATUS=in_progress
CURRENT_EDUCATION_DISCIPLINE=Advanced Materials Science and Engineering
FILTER_BY_EDUCATION=true
CANDIDATE_GRADUATION_YEAR=2027
CANDIDATE_AVAILABLE_FROM=2027-10-01
REJECT_12_MONTH_CONTRACT=true

# --- Email alerts (required for notifications) ---
# Recipient address — where job alerts are sent
NOTIFY_EMAIL=

# Option 1: Gmail (recommended — easiest)
# 1. Enable 2FA on your Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (no spaces)
GMAIL_APP_PASSWORD=
# Optional: defaults to NOTIFY_EMAIL if unset
# GMAIL_USER=your_personal_email@gmail.com

# Option 2: Maileroo API (Sending Key from Maileroo dashboard)
# MAILEROO_API_KEY=your_sending_key
# SMTP_FROM=your_address@your-domain.maileroo.org

# Option 3: Maileroo SMTP (or any SMTP provider)
# SMTP_HOST=smtp.maileroo.com
# SMTP_PORT=587
# SMTP_USER=your_address@your-domain.maileroo.org
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=your_address@your-domain.maileroo.org
# SMTP_FROM_NAME=Job Agent
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# Alternative: comma-separated companies in .env instead of companies.json
# TARGET_COMPANIES=Octopus Energy,EDF,National Grid,Johnson Matthey,Arup

# =============================================================================
# GitHub Actions (repo → Settings → Secrets and variables → Actions)
# =============================================================================
# Use a PRIVATE repo so job data and secrets stay private.
#
# Required for email alerts:
#   NOTIFY_EMAIL          your inbox
#   GMAIL_APP_PASSWORD    Gmail app password (recommended)
#
# Job search (recommended):
#   TARGET_COMPANIES      Octopus Energy,EDF,National Grid,Johnson Matthey,Arup
#   TARGET_ROLES          Graduate Energy Analyst,Graduate Materials Scientist
#   JOB_LOCATION          London, United Kingdom
#   USER_NAME             Your Name
#
# Optional private files (multiline secrets — not in the repo):
#   COMPANIES_JSON        full contents of config/companies.json
#   MASTER_RESUME         full resume text (only needed for --with-ai)
#
# Alternative email (instead of GMAIL_APP_PASSWORD):
#   MAILEROO_API_KEY      or SMTP_HOST + SMTP_USER + SMTP_PASSWORD + SMTP_FROM
#
# Test: Actions → Job Agent → Run workflow → check "Send a test email only"
